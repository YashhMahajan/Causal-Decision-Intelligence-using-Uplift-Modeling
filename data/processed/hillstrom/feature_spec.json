{
  "dataset": "hillstrom",
  "unit_of_analysis": "individual customer (one row; surrogate customer_uid)",
  "random_seed": 20240501,
  "test_size": 0.2,
  "n_rows_total": 64000,
  "n_train": 51200,
  "n_test": 12800,
  "X_features": [
    "recency",
    "history",
    "history_log1p",
    "mens",
    "womens",
    "newbie",
    "mw_count",
    "bought_both",
    "zip_code_Rural",
    "zip_code_Suburban",
    "zip_code_Urban",
    "channel_Multichannel",
    "channel_Phone",
    "channel_Web"
  ],
  "X_numeric_scaled_variant_cols": [
    "recency",
    "history",
    "history_log1p"
  ],
  "treatment_cols": [
    "treatment_arm",
    "T",
    "T_mens",
    "T_womens"
  ],
  "treatment_primary_binary": "T",
  "treatment_native_arms": [
    "control",
    "mens_email",
    "womens_email"
  ],
  "outcome_cols": [
    "visit",
    "conversion",
    "spend"
  ],
  "primary_outcome": "conversion",
  "secondary_outcome": "spend",
  "mediator_outcome": "visit",
  "excluded_from_X": {
    "post_treatment_outcomes": [
      "visit",
      "conversion",
      "spend"
    ],
    "derived_redundant": [
      "history_segment",
      "history_segment_ord"
    ],
    "identifiers_metadata": [
      "customer_uid",
      "split"
    ]
  },
  "learned_on_train_only": [
    "ColumnTransformer (one-hot categories, imputer statistics)",
    "StandardScaler (separate artifact, optional)"
  ],
  "artifacts": {
    "clean_full": "hillstrom_clean.csv",
    "train": "train.parquet / train.csv",
    "test": "test.parquet / test.csv",
    "scaled_variant": "train_scaled.parquet / test_scaled.parquet",
    "preprocessor": "preprocessor.joblib",
    "scaler": "scaler.joblib"
  }
}